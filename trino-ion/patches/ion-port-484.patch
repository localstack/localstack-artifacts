+/**
+ * Decodes Ion values into Trino columns as Athena reads them through the Ion Hive SerDe
+ * (com.amazon.ionhiveserde.IonHiveSerDe): the same accepted Ion types, overflow checks,
+ * truncations, NULLs and errors.
+ */
+public class IonDecoder
+{
+    private static final IonTextWriterBuilder TEXT_WRITER = IonTextWriterBuilder.standard().withCharsetAscii().immutable();
+    private static final String BAD_DATA_PREFIX = "Error Parsing a column in the table: ";
+    private static final String SERDE_LITE_PACKAGE = "com.amazon.ion.impl.lite.";
+    private static final String SERDE_DECORATOR_PACKAGE = "com.amazon.ionhiveserde.caseinsensitivedecorator.";
+
+    private final PathExtractor<PageBuilder> extractor;
+    private final List<Type> columnTypes;
+    private final boolean[] encountered;
+
+    /**
+     * Builds a decoder for the given columns and the configuration.
+     *
+     * @param columns the columns to decode
+     * @param tableColumnNames all columns of the table, decoded or not. Their search paths decide
+     * which values the decoded columns see, as they do for the SerDe.
+     */
+    public IonDecoder(
+            List<Column> columns,
+            List<String> tableColumnNames,
+            IonDecoderConfig decoderConfig)
+    {
+        ImmutableList.Builder<Type> columnTypesBuilder = ImmutableList.builder();
+        Map<String, BiFunction<IonReader, PageBuilder, Integer>> callbacks = new LinkedHashMap<>();
+        for (int pos = 0; pos < columns.size(); pos++) {
+            Column column = columns.get(pos);
+            BlockDecoder decoder = decoderForType(
+                    column.type(),
+                    new Options(decoderConfig.failOnOverflow(column.name()), decoderConfig.caseSensitive()));
+            callbacks.putIfAbsent(column.name(), callbackFor(decoder, pos));
+            columnTypesBuilder.add(column.type());
+        }
+
+        // The SerDe registers a search path for every column of the table, in the iteration order of a
+        // HashMap keyed by column name. Several columns can match the same value: they all read a
+        // scalar, but a container is consumed by the first one, and the others read NULL. A column
+        // whose path lies under another column's path reads NULL too, since that column consumed the
+        // container. Columns that are not decoded consume containers in the same way.
+        Map<String, BiFunction<IonReader, PageBuilder, Integer>> searchedColumns = new HashMap<>();
+        for (String name : tableColumnNames) {
+            searchedColumns.put(name, callbacks.getOrDefault(name, IonDecoder::consume));
+        }
+        callbacks.forEach(searchedColumns::putIfAbsent);
+
+        PathExtractorBuilder<PageBuilder> extractorBuilder = PathExtractorBuilder.<PageBuilder>standard()
+                .withMatchCaseInsensitive(!decoderConfig.caseSensitive());
+        for (Map.Entry<String, BiFunction<IonReader, PageBuilder, Integer>> entry : searchedColumns.entrySet()) {
+            String extractionPath = decoderConfig.pathExtractors().get(entry.getKey());
+            if (extractionPath == null) {
+                extractorBuilder.withSearchPath(List.of(new Text(entry.getKey())), entry.getValue());
+            }
+            else {
+                extractorBuilder.withSearchPath(extractionPath, entry.getValue());
+            }
+        }
+        // the legacy extractor matches like the SerDe's: any combination of paths, several callbacks per value
+        extractor = extractorBuilder.buildLegacy();
+        columnTypes = columnTypesBuilder.build();
+        encountered = new boolean[columns.size()];
+    }
+
+    /**
+     * Decodes the next value from the IonReader and appends it to the PageBuilder.
+     * Not thread-safe. If you need to do concurrent decoding, make multiple decoders.
+     */
+    public void decode(IonReader ionReader, PageBuilder pageBuilder)
+    {
+        pageBuilder.declarePosition();
+        extractor.matchCurrentValue(ionReader, pageBuilder);
+        for (int i = 0; i < encountered.length; i++) {
+            if (!encountered[i]) {
+                pageBuilder.getBlockBuilder(i).appendNull();
+            }
+            encountered[i] = false;
+        }
+    }
+
+    public List<Type> getColumnTypes()
+    {
+        return columnTypes;
+    }
+
+    private BiFunction<IonReader, PageBuilder, Integer> callbackFor(BlockDecoder decoder, int pos)
+    {
+        return (ionReader, pageBuilder) -> {
+            if (ionReader.getType() == null) {
+                // another column consumed this container
+                return 0;
+            }
+            BlockBuilder blockBuilder = pageBuilder.getBlockBuilder(pos);
+            // for "top-level" columns, we keep the last of any duplicate fields.
+            // this is consistent with the Ion Hive SerDe.
+            if (encountered[pos]) {
+                blockBuilder.resetTo(blockBuilder.getPositionCount() - 1);
+            }
+            else {
+                encountered[pos] = true;
+            }
+
+            decoder.decode(ionReader, blockBuilder);
+            return 0;
+        };
+    }
+
+    private static Integer consume(IonReader ionReader, PageBuilder pageBuilder)
+    {
+        IonType type = ionReader.getType();
+        if (type != null && IonType.isContainer(type) && !ionReader.isNullValue()) {
+            ionReader.stepIn();
+            ionReader.stepOut();
+        }
+        return 0;
+    }
+
+    private interface BlockDecoder
+    {
+        void decode(IonReader reader, BlockBuilder builder);
+    }
+
+    /**
+     * @param failOnOverflow whether a value that does not fit the column fails, or is narrowed
+     * @param caseSensitive whether struct fields match case-sensitively
+     */
+    private record Options(boolean failOnOverflow, boolean caseSensitive) {}
+
+    private static BlockDecoder decoderForType(Type type, Options options)
+    {
+        return switch (type) {
+            case TinyintType t -> wrapDecoder(intDecoder(t, "tinyint", Byte.MIN_VALUE, Byte.MAX_VALUE, value -> (byte) value, options), "IonInt", options, IonType.INT);
+            case SmallintType t -> wrapDecoder(intDecoder(t, "smallint", Short.MIN_VALUE, Short.MAX_VALUE, value -> (short) value, options), "IonInt", options, IonType.INT);
+            case IntegerType t -> wrapDecoder(intDecoder(t, "int", Integer.MIN_VALUE, Integer.MAX_VALUE, value -> value, options), "IonInt", options, IonType.INT);
+            case BigintType _ -> wrapDecoder(bigintDecoder(options), "IonInt", options, IonType.INT);
+            case RealType _ -> wrapDecoder(realDecoder(options), "IonFloat", options, IonType.FLOAT);
+            case DoubleType _ -> wrapDecoder(DOUBLE_DECODER, "IonFloat", options, IonType.FLOAT);
+            case DecimalType t -> nullable(decimalDecoder(t));
+            case BooleanType _ -> wrapDecoder(BOOL_DECODER, "IonBool", options, IonType.BOOL);
+            case DateType _ -> wrapDecoder(DATE_DECODER, "IonTimestamp", options, IonType.TIMESTAMP);
+            case TimestampType t -> wrapDecoder(timestampDecoder(t), "IonTimestamp", options, IonType.TIMESTAMP);
+            // a Hive string takes any Ion value, as text
+            case VarcharType t when t.isUnbounded() -> nullable(stringDecoder(t));
+            case VarcharType t -> wrapDecoder(varcharDecoder(t, options), "IonText", options, IonType.STRING, IonType.SYMBOL);
+            case CharType t -> wrapDecoder(charDecoder(t, options), "IonText", options, IonType.STRING, IonType.SYMBOL);
+            case VarbinaryType _ -> wrapDecoder(BINARY_DECODER, "IonLob", options, IonType.BLOB, IonType.CLOB);
+            case RowType t -> wrapDecoder(RowDecoder.forFields(t.getFields(), options), "IonStruct", options, IonType.STRUCT);
+            case ArrayType t -> wrapDecoder(new ArrayDecoder(decoderForType(t.getElementType(), options)), "IonSequence", options, IonType.LIST, IonType.SEXP);
+            case MapType t -> wrapDecoder(new MapDecoder(t, options), "IonStruct", options, IonType.STRUCT);
+            default -> throw new IllegalArgumentException(String.format("Unsupported type: %s", type));
+        };
+    }
+
+    /**
+     * Wraps decoders for common handling logic.
+     * <p>
+     * Any null value, typed or not, reads as NULL.
+     * A value of another type fails as the SerDe's cast to the Ion interface it reads fails.
+     * Delegates to Decoder for correctly-typed, non-null values.
+     */
+    private static BlockDecoder wrapDecoder(BlockDecoder decoder, String serDeInterface, Options options, IonType... allowedTypes)
+    {
+        Set<IonType> allowed = EnumSet.copyOf(List.of(allowedTypes));
+        return (reader, builder) -> {
+            if (reader.isNullValue()) {
+                builder.appendNull();
+                return;
+            }
+            IonType ionType = reader.getType();
+            if (!allowed.contains(ionType)) {
+                throw castError(ionType, "com.amazon.ion." + serDeInterface, options.caseSensitive());
+            }
+            decoder.decode(reader, builder);
+        };
+    }
+
+    private static BlockDecoder nullable(BlockDecoder decoder)
+    {
+        return (reader, builder) -> {
+            if (reader.isNullValue()) {
+                builder.appendNull();
+            }
+            else {
+                decoder.decode(reader, builder);
+            }
+        };
+    }
+
+    /**
+     * The error of the SerDe's cast of a value to the Ion interface its column reads, as the JVM words
+     * it: the SerDe holds values as ion-java's DOM classes, and wraps containers in its case-insensitive
+     * decorators unless path extraction is case-sensitive.
+     */
+    private static TrinoException castError(IonType ionType, String serDeInterface, boolean caseSensitive)
+    {
+        String valueClass = switch (ionType) {
+            case LIST, SEXP -> caseSensitive ? liteClass(ionType) : SERDE_DECORATOR_PACKAGE + "IonSequenceCaseInsensitiveDecorator";
+            case STRUCT -> caseSensitive ? liteClass(ionType) : SERDE_DECORATOR_PACKAGE + "IonStructCaseInsensitiveDecorator";
+            default -> liteClass(ionType);
+        };
+        ClassLoader loader = IonDecoder.class.getClassLoader();
+        String loaderDescription = loader.getClass().getName() + " @" + Integer.toHexString(System.identityHashCode(loader));
+        return new TrinoException(
+                SerDeErrorCode.GENERIC_INTERNAL_ERROR,
+                "class %s cannot be cast to class %s (%s and %s are in unnamed module of loader %s)"
+                        .formatted(valueClass, serDeInterface, valueClass, serDeInterface, loaderDescription));
+    }
+
+    private static String liteClass(IonType ionType)
+    {
+        String name = ionType.name();
+        return SERDE_LITE_PACKAGE + "Ion" + name.charAt(0) + name.substring(1).toLowerCase(Locale.ROOT) + "Lite";
+    }
+
+    private static TrinoException badData(String message)
+    {
+        return new TrinoException(SerDeErrorCode.HIVE_BAD_DATA, BAD_DATA_PREFIX + message);
+    }
+
+    private static TrinoException insufficientPrecision(IonReader reader, String hiveType)
+    {
+        return badData("insufficient precision for %s as %s".formatted(ionText(reader), hiveType));
+    }
+
+    private record RowDecoder(Map<String, Integer> fieldPositions, List<String> fieldNames, List<BlockDecoder> fieldDecoders, boolean caseSensitive)
+            implements BlockDecoder
+    {
+        private static RowDecoder forFields(List<RowType.Field> fields, Options options)
+        {
+            ImmutableList.Builder<BlockDecoder> decoderBuilder = ImmutableList.builder();
+            ImmutableList.Builder<String> fieldNameBuilder = ImmutableList.builder();
+            Map<String, Integer> fieldPositions = new HashMap<>();
+            for (int pos = 0; pos < fields.size(); pos++) {
+                RowType.Field field = fields.get(pos);
+                String name = field.getName().orElseThrow();
+                decoderBuilder.add(decoderForType(field.getType(), options));
+                fieldNameBuilder.add(name);
+                fieldPositions.putIfAbsent(options.caseSensitive() ? name : name.toLowerCase(Locale.ROOT), pos);
+            }
+            return new RowDecoder(fieldPositions, fieldNameBuilder.build(), decoderBuilder.build(), options.caseSensitive());
+        }
+
+        @Override
+        public void decode(IonReader ionReader, BlockBuilder blockBuilder)
+        {
+            ((RowBlockBuilder) blockBuilder)
+                    .buildEntry(fieldBuilders -> decode(ionReader, fieldBuilders::get));
+        }
+
+        // assumes that the reader is positioned on a non-null struct value
+        private void decode(IonReader ionReader, IntFunction<BlockBuilder> blockSelector)
+        {
+            // Like the SerDe's struct lookup: an exact match of the field name wins over one that only
+            // matches ignoring case, and among duplicate fields the first one wins.
+            int[] matched = new int[fieldDecoders.size()];
+            ionReader.stepIn();
+
+            while (ionReader.next() != null) {
+                String fieldName = ionReader.getFieldName();
+                Integer fieldIndex = fieldPositions.get(caseSensitive ? fieldName : fieldName.toLowerCase(Locale.ROOT));
+                if (fieldIndex == null) {
+                    continue;
+                }
+                int match = fieldName.equals(fieldNames.get(fieldIndex)) ? 2 : 1;
+                if (match <= matched[fieldIndex]) {
+                    continue;
+                }
+                BlockBuilder blockBuilder = blockSelector.apply(fieldIndex);
+                if (matched[fieldIndex] != 0) {
+                    blockBuilder.resetTo(blockBuilder.getPositionCount() - 1);
+                }
+                fieldDecoders.get(fieldIndex).decode(ionReader, blockBuilder);
+                matched[fieldIndex] = match;
+            }
+
+            for (int i = 0; i < matched.length; i++) {
+                if (matched[i] == 0) {
+                    blockSelector.apply(i).appendNull();
+                }
+            }
+
+            ionReader.stepOut();
+        }
+    }
+
+    private static class MapDecoder
+            implements BlockDecoder
+    {
+        private final BiConsumer<String, BlockBuilder> keyConsumer;
+        private final BlockDecoder valueDecoder;
+        private final DistinctMapKeys distinctMapKeys;
+        private BlockBuilder keyBlockBuilder;
+        private BlockBuilder valueBlockBuilder;
+
+        MapDecoder(MapType mapType, Options options)
+        {
+            Type keyType = mapType.getKeyType();
+            Type valueType = mapType.getValueType();
+            this.valueDecoder = decoderForType(valueType, options);
+            // we configure the distinct key selector to use the last entry
+            // this is consistent with how the Ion Hive SerDe handled duplicate map fields.
+            this.distinctMapKeys = new DistinctMapKeys(mapType, true);
+            this.keyBlockBuilder = keyType.createBlockBuilder(null, 128);
+            this.valueBlockBuilder = valueType.createBlockBuilder(null, 128);
+
+            this.keyConsumer = switch (keyType) {
+                case VarcharType t -> {
+                    yield (String fieldName, BlockBuilder blockBuilder) ->
+                            t.writeSlice(blockBuilder, Varchars.truncateToLength(Slices.utf8Slice(fieldName), t));
+                }
+                case CharType t -> {
+                    yield (String fieldName, BlockBuilder blockBuilder) ->
+                            t.writeSlice(blockBuilder, Chars.truncateToLengthAndTrimSpaces(Slices.utf8Slice(fieldName), t));
+                }
+                default -> throw new UnsupportedOperationException("Unsupported map key type: " + keyType);
+            };
+        }
+
+        @Override
+        public void decode(IonReader ionReader, BlockBuilder builder)
+        {
+            ionReader.stepIn();
+            // buffer the keys and values
+            while (ionReader.next() != null) {
+                keyConsumer.accept(ionReader.getFieldName(), keyBlockBuilder);
+                valueDecoder.decode(ionReader, valueBlockBuilder);
+            }
+            ValueBlock keys = keyBlockBuilder.buildValueBlock();
+            ValueBlock values = valueBlockBuilder.buildValueBlock();
+            keyBlockBuilder = keyBlockBuilder.newBlockBuilderLike(null);
+            valueBlockBuilder = valueBlockBuilder.newBlockBuilderLike(null);
+
+            // copy the distinct key entries to the output.
+            boolean[] distinctKeys = distinctMapKeys.selectDistinctKeys(keys);
+
+            ((MapBlockBuilder) builder).buildEntry((keyBuilder, valueBuilder) -> {
+                for (int index = 0; index < distinctKeys.length; index++) {
+                    boolean distinctKey = distinctKeys[index];
+                    if (distinctKey) {
+                        keyBuilder.append(keys, index);
+                        valueBuilder.append(values, index);
+                    }
+                }
+            });
+            ionReader.stepOut();
+        }
+    }
+
+    private record ArrayDecoder(BlockDecoder elementDecoder)
+            implements BlockDecoder
+    {
+        @Override
+        public void decode(IonReader ionReader, BlockBuilder blockBuilder)
+        {
+            ((ArrayBlockBuilder) blockBuilder)
+                    .buildEntry(elementBuilder -> {
+                        ionReader.stepIn();
+                        while (ionReader.next() != null) {
+                            elementDecoder.decode(ionReader, elementBuilder);
+                        }
+                        ionReader.stepOut();
+                    });
+        }
+    }
+
+    private static BlockDecoder timestampDecoder(TimestampType type)
+    {
+        // The SerDe reads the timestamp's UTC instant in milliseconds: finer fractions are truncated.
+        return (reader, builder) -> {
+            long epochMicros = reader.timestampValue().getMillis() * Timestamps.MICROSECONDS_PER_MILLISECOND;
+            if (type.isShort()) {
+                type.writeLong(builder, epochMicros);
+            }
+            else {
+                type.writeObject(builder, new LongTimestamp(epochMicros, 0));
+            }
+        };
+    }
+
+    private static BlockDecoder decimalDecoder(DecimalType type)
+    {
+        int precision = type.getPrecision();
+        int scale = type.getScale();
+
+        return (reader, builder) -> {
+            IonType ionType = reader.getType();
+            if (ionType != IonType.INT && ionType != IonType.DECIMAL) {
+                throw badData("Invalid Ion type: " + ionType);
+            }
+            // The SerDe's HiveDecimal drops trailing zeros, and Athena rescales it to the column's scale.
+            BigDecimal decimal = ionType == IonType.INT ? new BigDecimal(reader.bigIntegerValue()) : reader.bigDecimalValue();
+            decimal = decimal.stripTrailingZeros();
+            if (decimal.scale() < 0) {
+                decimal = decimal.setScale(0);
+            }
+            if (decimal.scale() > scale) {
+                throw badData("target scale must be larger than source scale");
+            }
+            BigInteger unscaled = decimal.setScale(scale).unscaledValue();
+            // Athena returns a value with more digits than the precision as it is, but Trino cannot
+            // send such a value to its clients.
+            if (Decimals.overflows(unscaled, precision)) {
+                throw new TrinoException(StandardErrorCode.NUMERIC_VALUE_OUT_OF_RANGE,
+                        "Decimal value %s does not fit %d digits of precision and %d of scale!".formatted(decimal, precision, scale));
+            }
+            if (type.isShort()) {
+                type.writeLong(builder, unscaled.longValue());
+            }
+            else {
+                type.writeObject(builder, Int128.valueOf(unscaled));
+            }
+        };
+    }
+
+    /**
+     * The value as the SerDe prints it: Ion text with ASCII characters only.
+     */
+    private static String ionText(IonReader ionReader)
+    {
+        StringBuilder stringBuilder = new StringBuilder();
+        try (IonWriter writer = TEXT_WRITER.build(stringBuilder)) {
+            writer.writeValue(ionReader);
+        }
+        catch (IOException e) {
+            throw new RuntimeException(e);
+        }
+        return stringBuilder.toString();
+    }
+
+    private static String textValue(IonReader ionReader)
+    {
+        IonType valueType = ionReader.getType();
+        if (valueType == IonType.SYMBOL || valueType == IonType.STRING) {
+            return ionReader.stringValue();
+        }
+        // For any types other than IonType.SYMBOL and IonType.STRING, performs text coercion
+        return ionText(ionReader);
+    }
+
+    private static BlockDecoder stringDecoder(VarcharType type)
+    {
+        return (ionReader, blockBuilder) ->
+                type.writeSlice(blockBuilder, Slices.utf8Slice(textValue(ionReader)));
+    }
+
+    private static BlockDecoder varcharDecoder(VarcharType type, Options options)
+    {
+        return (ionReader, blockBuilder) -> {
+            String value = ionReader.stringValue();
+            checkTextLength(value, type.getBoundedLength(), options);
+            type.writeSlice(blockBuilder, Varchars.truncateToLength(Slices.utf8Slice(value), type));
+        };
+    }
+
+    private static BlockDecoder charDecoder(CharType type, Options options)
+    {
+        return (ionReader, blockBuilder) -> {
+            String value = ionReader.stringValue();
+            checkTextLength(value, type.getLength(), options);
+            type.writeSlice(blockBuilder, Chars.truncateToLengthAndTrimSpaces(Slices.utf8Slice(value), type));
+        };
+    }
+
+    private static void checkTextLength(String text, int maxLength, Options options)
+    {
+        if (options.failOnOverflow() && text.length() > maxLength) {
+            throw badData("text is longer than allowed. Size: " + text.length() + ", max: " + maxLength);
+        }
+    }
+
+    /**
+     * Without failOnOverflow, the SerDe narrows the low 32 bits of the value like a Java cast.
+     */
+    private static BlockDecoder intDecoder(Type type, String hiveType, int min, int max, IntUnaryOperator narrow, Options options)
+    {
+        return (ionReader, blockBuilder) -> {
+            int value;
+            if (options.failOnOverflow()) {
+                if (ionReader.getIntegerSize() != IntegerSize.INT || ionReader.intValue() < min || ionReader.intValue() > max) {
+                    throw insufficientPrecision(ionReader, hiveType);
+                }
+                value = ionReader.intValue();
+            }
+            else {
+                value = narrow.applyAsInt(ionReader.bigIntegerValue().intValue());
+            }
+            type.writeLong(blockBuilder, value);
+        };
+    }
+
+    private static BlockDecoder bigintDecoder(Options options)
+    {
+        return (ionReader, blockBuilder) -> {
+            long value;
+            if (ionReader.getIntegerSize() != IntegerSize.BIG_INTEGER) {
+                value = ionReader.longValue();
+            }
+            else if (options.failOnOverflow()) {
+                throw insufficientPrecision(ionReader, "bigint");
+            }
+            else {
+                value = ionReader.bigIntegerValue().longValue();
+            }
+            BigintType.BIGINT.writeLong(blockBuilder, value);
+        };
+    }
+
+    private static BlockDecoder realDecoder(Options options)
+    {
+        return (ionReader, blockBuilder) -> {
+            double value = ionReader.doubleValue();
+            if (options.failOnOverflow() && Double.compare((float) value, value) != 0) {
+                throw insufficientPrecision(ionReader, "float");
+            }
+            RealType.REAL.writeFloat(blockBuilder, (float) value);
+        };
+    }
+
+    private static final BlockDecoder DOUBLE_DECODER = (ionReader, blockBuilder) ->
+            DoubleType.DOUBLE.writeDouble(blockBuilder, ionReader.doubleValue());
+
+    private static final BlockDecoder BOOL_DECODER = (ionReader, blockBuilder) ->
+            BooleanType.BOOLEAN.writeBoolean(blockBuilder, ionReader.booleanValue());
+
+    private static final BlockDecoder DATE_DECODER = (ionReader, blockBuilder) -> {
+        Timestamp ionTs = ionReader.timestampValue();
+        LocalDate localDate = LocalDate.of(ionTs.getZYear(), ionTs.getZMonth(), ionTs.getZDay());
+        DateType.DATE.writeLong(blockBuilder, localDate.toEpochDay());
+    };
+
+    private static final BlockDecoder BINARY_DECODER = (ionReader, blockBuilder) ->
+            VarbinaryType.VARBINARY.writeSlice(blockBuilder, Slices.wrappedBuffer(ionReader.newBytes()));
+
+    /**
+     * The errors Athena reports for the SerDe: HIVE_BAD_DATA for a value that fails a check, and
+     * GENERIC_INTERNAL_ERROR for a value of the wrong Ion type, both counted as user errors.
+     */
+    private enum SerDeErrorCode
+            implements ErrorCodeSupplier
+    {
+        // the code of HiveErrorCode.HIVE_BAD_DATA, which this library cannot use
+        HIVE_BAD_DATA(0x0100_0000 + 7),
+        GENERIC_INTERNAL_ERROR(StandardErrorCode.GENERIC_INTERNAL_ERROR.toErrorCode().getCode());
+
+        private final ErrorCode errorCode;
+
+        SerDeErrorCode(int code)
+        {
+            errorCode = new ErrorCode(code, name(), ErrorType.EXTERNAL);
+        }
+
+        @Override
+        public ErrorCode toErrorCode()
+        {
+            return errorCode;
+        }
+    }
+}
