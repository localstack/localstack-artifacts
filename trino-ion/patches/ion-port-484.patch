+package io.trino.hive.formats.ion;
+
+import com.google.common.collect.ImmutableMap;
+
+import java.util.Map;
+
+/**
+ * Captures the SerDe properties that affect decoding.
+ *
+ * @param pathExtractors Map of column name => ion paths
+ *        for each entry in the map, the value bound to the column will be the result
+ *        of extracting the given search path.
+ * @param caseSensitive whether field name matching should be case-sensitive or not.
+ * @param failOnOverflow whether a value that does not fit its column fails the query,
+ *        for columns without their own setting; otherwise it is narrowed like a Java cast.
+ * @param columnFailOnOverflow the columns' own failOnOverflow settings, by column name.
+ */
+public record IonDecoderConfig(
+        Map<String, String> pathExtractors,
+        boolean caseSensitive,
+        boolean failOnOverflow,
+        Map<String, Boolean> columnFailOnOverflow)
+{
+    public IonDecoderConfig
+    {
+        pathExtractors = ImmutableMap.copyOf(pathExtractors);
+        columnFailOnOverflow = ImmutableMap.copyOf(columnFailOnOverflow);
+    }
+
+    static IonDecoderConfig defaultConfig()
+    {
+        return new IonDecoderConfig(Map.of(), false, true, Map.of());
+    }
+
+    IonDecoderConfig withCaseSensitive()
+    {
+        return new IonDecoderConfig(pathExtractors, true, failOnOverflow, columnFailOnOverflow);
+    }
+
+    IonDecoderConfig withPathExtractors(Map<String, String> pathExtractors)
+    {
+        return new IonDecoderConfig(pathExtractors, caseSensitive, failOnOverflow, columnFailOnOverflow);
+    }
+
+    boolean failOnOverflow(String columnName)
+    {
+        return columnFailOnOverflow.getOrDefault(columnName, failOnOverflow);
+    }
+}
